# Locus runs without any of these.
# Notes, the canvas, the notebook, the graph and Atlas stay in the browser
# (localStorage). Postgres and sign-in are optional platform hooks.

# "false" matches config/app-env.json: no account, dev identity only.
# Set to "true" only when the auth variables below are real.
VITE_AUTH_ENABLED=false

# Postgres connection (Neon or any Postgres). When unset, server code falls
# back to an in-memory PGLite database and applies migrations/*.sql.
# Locus itself does not store notes here.
DATABASE_URL=

# Better Auth. Unused while VITE_AUTH_ENABLED=false.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

# Federated sign-in broker. Leave blank for a local vault.
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
GROK_PROJECT_ID=
GROK_GATE_ORIGIN=

# Optional. Live flight lookup can use OpenSky when these client credentials exist.
# Without them, Locus still asks the keyless aircraft feed.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional. Active fire alerts use NASA FIRMS only when this key is set.
NASA_FIRMS_KEY=

# Optional. When set, Atlas pattern extraction can call the xAI API.
# Without it, extraction stays on the local distill path.
XAI_API_KEY=

# Optional STUN servers for the unused multiplayer helper (comma-separated).
VITE_STUN_URLS=
